# ─── cliProxy — Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in the values.

# ─── Required ────────────────────────────────────────────────────────────────

# Client authentication key (protects the proxy from unauthorized use)
# CLIPROXY_API_KEY=<your-secret-key>

# Comma-separated model IDs to advertise via GET /v1/models
# Format: bare IDs (deepseek-v4-pro) or cliproxy/<model>
# CLIPROXY_MODELS=deepseek-v4-pro,kimi-k2.6,cliproxy/gpt-general

# ─── Provider API Keys ───────────────────────────────────────────────────────
# At least one provider key is required for the proxy to function.

# DEEPSEEK_API_KEY=<sk-your-deepseek-key>
# KIMI_API_KEY=<sk-your-kimi-key>
# MINIMAX_API_KEY=<your-minimax-key>
# AZURE_FOUNDRY_API_KEY=<your-azure-foundry-key>

# Azure Foundry requires a resource name in addition to the API key
# AZURE_FOUNDRY_RESOURCE=<resource-name>

# ─── Optional: KV Cache Backends ─────────────────────────────────────────────
# The proxy uses KV storage for reasoning caching, response ID chaining,
# Claude thinking caching, and vision description caching. If no KV backend
# is configured, caching is silently disabled.

# Docker (local Redis)
# REDIS_URL=redis://redis:6379

# Vercel (Upstash REST)
# KV_URL=https://<upstash-url>
# KV_TOKEN=<your-upstash-token>

# EdgeOne Pages — detected automatically via global binding

# KV TTL in seconds (default: 7200 = 2 hours for conversation keys)
# KV_TTL_SECONDS=7200

# Image description cache TTL in seconds (default: 604800 = 7 days)
# KV_IMAGE_TTL_SECONDS=604800

# KV retry delays for fast follow-up races (comma-separated ms, default: 40,120,240,400)
# KV_RETRY_DELAYS_MS=40,120,240,400

# ─── Optional: Azure-Specific ────────────────────────────────────────────────

# Azure OpenAI API version (default: 2025-04-01-preview)
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Override the default Azure OpenAI endpoint
# AZURE_OPENAI_ENDPOINT=https://<custom-endpoint>

# Override the default Azure Anthropic endpoint
# AZURE_ANTHROPIC_ENDPOINT=https://<custom-endpoint>

# Force reasoning effort for Azure OpenAI reasoning models
# AZURE_OPENAI_REASONING_EFFORT=medium

# Azure OpenAI alias target deployment (required for cliproxy/gpt-general alias)
# AZURE_OPENAI_GENERAL_ALIAS_TARGET=gpt-5.5-mini
# AZURE_OPENAI_GENERAL_REASONING_EFFORT=medium

# Azure Anthropic thinking mode: adaptive, disabled
# AZURE_ANTHROPIC_THINKING=adaptive

# Azure Anthropic effort level: low, medium, high, max
# AZURE_ANTHROPIC_EFFORT=medium

# Azure OpenAI response cache version (bump to invalidate orphaned response IDs)
# AZURE_OPENAI_RESPONSE_CACHE_VERSION=v7

# ─── Optional: Upstream URL Overrides ────────────────────────────────────────

# UPSTREAM_DEEPSEEK=https://api.deepseek.com
# UPSTREAM_KIMI=https://api.moonshot.ai
# UPSTREAM_MINIMAX=https://api.minimax.io

# ─── Optional: Debug & Operations ────────────────────────────────────────────

# Enable verbose request/response logging (never use in production)
# DEBUG=false

# Docker exposed port (default: 3000)
# PORT=3000

# Trust x-forwarded-* headers when behind a reverse proxy
# TRUST_PROXY=false

# Max request body size in bytes (default: 25 MB)
# MAX_BODY_BYTES=26214400

# Grace period for draining in-flight requests on shutdown (ms, default: 25000)
# SHUTDOWN_GRACE_MS=25000

# EdgeOne KV binding name (default: cliproxy_kv)
# EDGEONE_KV_BINDING=cliproxy_kv
